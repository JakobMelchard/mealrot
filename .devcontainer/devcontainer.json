{
  "name": "cf",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "features": {
    "ghcr.io/jakobmelchard/devcontainer/ws:1": {},
    "ghcr.io/jakobmelchard/devcontainer/wrangler:1": {}
  },
  "postCreateCommand": "npm install && prek install",
  "forwardPorts": [
    8788
  ],
  "customizations": {
    "codespaces": {
      "repositories": {
        "JakobMelchard/.github": {
          "permissions": {
            "contents": "read"
          }
        }
      }
    }
  }
}
